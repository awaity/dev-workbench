{
  "name": "dev-workbench",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm run icons && vue-tsc --noEmit && node scripts/licenses.mjs && vite build",
    "zip": "pnpm run build && node scripts/package.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "pnpm run lint:eslint && pnpm run lint:style && pnpm run lint:conventions",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm run build && node scripts/test-extension.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "icons": "node scripts/generate-icons.mjs",
    "lint:conventions": "node scripts/check-conventions.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:e2e:cleanup": "pnpm run build && node scripts/test-auto-cleanup.mjs",
    "test:e2e:popup": "pnpm run build && node scripts/test-todo-popup.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "^1.2.1",
    "bcryptjs": "^3.0.2",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.14.7",
    "idb": "^8.0.3",
    "jsonpath-plus": "^10.3.0",
    "node-forge": "^1.3.1",
    "qr-code-styling": "^1.9.2",
    "sm-crypto": "^0.5.8",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.1.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node-forge": "^1.3.11",
    "@types/sm-crypto": "^0.3.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@zip.js/zip.js": "^2.24.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "jsqr": "^1.4.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0",
    "ws": "^8.18.0"
  }
}
