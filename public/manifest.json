{
  "manifest_version": 3,
  "name": "开发工作台",
  "version": "1.3.0",
  "description": "今日待办与本地开发工作台：待办清单、Markdown 导出、HTTP、WebSocket、加密编码、JSON 和二维码。",
  "permissions": ["unlimitedStorage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "今日待办 · 开发工作台",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "index.html#settings",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
